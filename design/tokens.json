{
  "name": "Korouhanba portfolio",
  "note": "Values actually used by the approved design (Nov 2026). Dark theme only on the site. No accent colour, no monospace face.",
  "color": {
    "bg-000": { "value": "#0b0c0d", "usage": "Page ground" },
    "bg-100": { "value": "#141517", "usage": "Raised surface: the hero pill" },
    "shelf-light": { "value": "#1b1c1e", "usage": "Centre of the shelf nook's overhead light" },
    "shelf-mid": { "value": "#121314", "usage": "Shelf nook mid tone" },
    "shelf-dark": { "value": "#0d0e0f", "usage": "Shelf nook edges" },
    "line-100": { "value": "#26282b", "usage": "Hairline rules between sections, pill border" },
    "line-200": { "value": "#3a3d41", "usage": "Outlined button border" },
    "ink": { "value": "#ededea", "usage": "Text, globe disc, cue line" },
    "ink-muted": { "value": "#8d9094", "usage": "Secondary text (6.1:1 on bg-000)" }
  },
  "books": [
    { "cloth": "#1f3b2f", "foil": "#d6c08a", "spineWidth": 62, "height": 420 },
    { "cloth": "#4a1d2a", "foil": "#e0cfa8", "spineWidth": 74, "height": 450 },
    { "cloth": "#e4ddcc", "foil": "#1d1c1a", "spineWidth": 56, "height": 400 },
    { "cloth": "#1d2a44", "foil": "#d4d7dc", "spineWidth": 68, "height": 436 },
    { "cloth": "#a8742a", "foil": "#1a1408", "spineWidth": 60, "height": 410 },
    { "cloth": "#2b2a28", "foil": "#e6dfcf", "spineWidth": 70, "height": 444 }
  ],
  "type": {
    "family": "\"Inter Tight\", \"Helvetica Neue\", Arial, sans-serif",
    "weights": [400, 500],
    "styles": {
      "hero-name": "clamp(96px, 17vw, 280px) / 0.88, 500, -0.05em (phones: clamp(56px, 19vw, 96px))",
      "story-line": "clamp(32px, 4.4vw, 64px) / 1.04, 500, -0.035em",
      "section-title": "clamp(48px, 6.6vw, 96px) / 0.95, 500, -0.04em",
      "talk": "clamp(56px, 10vw, 160px) / 0.9, 500, -0.05em",
      "intro-line": "clamp(24px, 2.6vw, 36px) / 1.15, 500, -0.02em",
      "greeting": "clamp(40px, 6vw, 72px), 500, -0.03em",
      "book-title-detail": "40px / 1.05, 500, -0.03em (phones 32px)",
      "body-l": "20px / 1.45",
      "body": "16px / 1.5",
      "nav": "16px, -0.01em",
      "small": "14px",
      "cursor-label": "16px, 500, -0.02em"
    }
  },
  "layout": {
    "maxWidth": "1440px",
    "gutter": "32px (16px under 760px)",
    "grid": "12 columns, 32px gap; story lines and book details start at column 4",
    "breakpoint": "760px"
  },
  "motion": {
    "ease": "cubic-bezier(.2,.8,.2,1)",
    "introEase": "cubic-bezier(.7,0,.2,1)",
    "bookTurn": "700ms",
    "introLeave": "900ms",
    "cursorFollow": "lerp 0.22 per frame",
    "globeCycle": "sin(t / 3200ms): about 20 s round trip"
  }
}
